<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/miniPlayerContainer"
    android:layout_width="match_parent"
    android:layout_height="64dp"
    android:background="@color/bg_card"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="12dp"
    android:clickable="true"
    android:focusable="true">

    <!-- Track Cover -->
    <ImageView
        android:id="@+id/miniCover"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:src="@drawable/placeholder_album"
        android:scaleType="centerCrop"
        android:layout_marginEnd="12dp" />

    <!-- Track Info -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/miniTrackTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Track Title"
            android:textColor="@color/text_primary"
            android:textSize="13sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/miniArtistName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Artist"
            android:textColor="@color/text_secondary"
            android:textSize="11sp"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>

    <!-- Play/Pause Button -->
    <FrameLayout
        android:layout_width="40dp"
        android:layout_height="40dp">

        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_play_button_small" />

        <ImageButton
            android:id="@+id/miniPlayPause"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_pause"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:tint="@color/white"
            android:contentDescription="Play/Pause" />
    </FrameLayout>

</LinearLayout>
