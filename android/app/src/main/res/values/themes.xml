<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.MusicApp" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/purple_primary</item>
        <item name="colorPrimaryVariant">@color/purple_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/pink_accent</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="android:windowBackground">@color/bg_dark</item>
        <item name="android:statusBarColor">@color/bg_dark</item>
        <item name="android:navigationBarColor">@color/bg_dark</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="Theme.MusicApp.Splash" parent="Theme.MusicApp">
        <item name="android:windowBackground">@color/bg_dark</item>
    </style>

    <style name="Theme.MusicApp.Player" parent="Theme.MusicApp">
        <item name="android:windowBackground">@color/bg_dark</item>
    </style>

    <!-- EditText style -->
    <style name="Widget.MusicApp.TextInputLayout" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxBackgroundColor">@color/bg_input</item>
        <item name="boxStrokeColor">@color/divider</item>
        <item name="hintTextColor">@color/text_hint</item>
        <item name="android:textColorHint">@color/text_hint</item>
    </style>

    <!-- Button style -->
    <style name="Widget.MusicApp.Button" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/purple_primary</item>
        <item name="cornerRadius">50dp</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
    </style>

    <!-- Outline Button -->
    <style name="Widget.MusicApp.Button.Outline" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="strokeColor">@color/divider</item>
        <item name="cornerRadius">50dp</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:backgroundTint">@color/bg_card</item>
        <item name="android:textSize">15sp</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
    </style>

    <!-- Bottom Sheet style -->
    <style name="Widget.MusicApp.BottomSheet" parent="Widget.MaterialComponents.BottomSheet">
        <item name="android:background">@color/bg_card</item>
    </style>

    <!-- Card style -->
    <style name="Widget.MusicApp.Card" parent="Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">@color/bg_card</item>
        <item name="cardCornerRadius">12dp</item>
        <item name="cardElevation">0dp</item>
    </style>
    <!-- Dialog style -->
    <style name="Theme.MusicApp.Dialog" parent="Theme.MaterialComponents.DayNight.Dialog">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="colorPrimary">@color/purple_primary</item>
        <item name="android:windowMinWidthMajor">90%</item>
        <item name="android:windowMinWidthMinor">90%</item>
    </style>

</resources>
