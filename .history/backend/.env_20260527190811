# ============================================================
# Music App — Environment Configuration
# ============================================================

# SQL Server connection string
# Поменяй SERVER на своё имя сервера SSMS (например: localhost\SQLEXPRESS)
DB_SERVER=localhost\SQLEXPRESS
DB_NAME=MusicAppDB
DB_DRIVER=ODBC Driver 17 for SQL Server
# Если используешь SQL-аутентификацию:
DB_USER=sa
DB_PASSWORD=YourPassword123!
# Если используешь Windows Auth: DB_TRUSTED=yes, DB_USER и DB_PASSWORD не нужны
DB_TRUSTED=no

# JWT
SECRET_KEY=supersecretkey_change_in_production_12345678
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# App
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=true

# Media paths (локальное хранилище)
STATIC_DIR=static
AUDIO_DIR=static/audio
COVERS_DIR=static/covers
AVATARS_DIR=static/avatars
